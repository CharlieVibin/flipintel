# FlipIntel configuration. Copy to .env and edit; every value is optional.
# Vinted and Gumtree work with no credentials.

# eBay UK uses the free official Browse API. Create an app at
# https://developer.ebay.com/my/keys, then paste the keys here and restart.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production (default) or sandbox
EBAY_ENV=production

# Optional Discord webhook for new-deal alerts.
DISCORD_WEBHOOK_URL=

# Scanner behaviour
SCANNER_AUTOSTART=true
RESPECT_ROBOTS=true
SCAN_INTERVAL_VINTED=240
SCAN_INTERVAL_GUMTREE=300
SCAN_INTERVAL_EBAY=300
QUERIES_PER_CYCLE=12

# CeX is an optional resale anchor. It may block this network; deals still
# work from live marketplace comparables.
CEX_ENABLED=true

# Network
RIGRADAR_HOST=127.0.0.1
RIGRADAR_PORT=8765
# A generic PORT is ignored when it is 0.
# PORT=8765

# Optional custom browser user agent for outbound marketplace requests.
# USER_AGENT=
